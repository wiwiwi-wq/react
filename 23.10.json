const http = require('http');
const fs = require('fs');
const path = require('path');
const { WebSocketServer } = require('ws');

const server = http.createServer((req, res) => {
  let filePath = req.url === '/' ? './index.html' : '.' + req.url;
  const ext = path.extname(filePath);
  const contentTypes = {
    '.html': 'text/html',
    '.js': 'application/javascript',
    '.css': 'text/css',
    '.json': 'application/json',
  };

  fs.readFile(filePath, (err, content) => {
    if (err) {
      res.writeHead(404);
      res.end('Not found');
    } else {
      res.writeHead(200, { 'Content-Type': contentTypes[ext] || 'text/plain' });
      res.end(content);
    }
  });
});

const wss = new WebSocketServer({ server });

const watchedFile = path.resolve(__dirname, 'test.js');

wss.on('connection', (ws) => {
  console.log('📡 Client connected');

  ws.send(JSON.stringify({
    type: 'connected',
    message: 'HMR server ready',
  }));

  ws.on('close', () => {
    console.log('📡 Client disconnected');
  });
});

fs.watch(watchedFile, (eventType, filename) => {
  console.log(`📝 File changed: ${filename} (${eventType})`);

  const message = JSON.stringify({
    type: 'reload',
    timestamp: Date.now(),
  });

  wss.clients.forEach((client) => {
    if (client.readyState === 1) {
      console.log('  → Sending reload to client');
      client.send(message);
    }
  });
});

const PORT = 3001;
server.listen(PORT, () => {
  console.log(`🚀 HMR Server running on http://localhost:${PORT}`);
  console.log(`📂 Watching: ${watchedFile}`);
});

process.on('SIGINT', () => {
  console.log('\n👋 Shutting down HMR server...');
  wss.close();
  server.close();
  process.exit(0);
});
задача 11

function deepFreeze(object) {
  const ownKeys = Object.getOwnPropertyNames(object);
  
  ownKeys.forEach((key) => {
    const value = object[key];
    
    if (value && typeof value === 'object') {
      deepFreeze(value);
    }
  });

  return Object.freeze(object);
}
задача 12

function createCounter(initialValue = 0, step = 1) {
  let count = initialValue;

  return {
    inc() {
      count += step;
      return count;
    },
    
    dec() {
      count -= step;
      return count;
    },
    
    reset() {
      count = initialValue;
      return count;
    },
    
    get() {
      return count;
    },
  };
}
задача 13

function memoize(fn) {
  const cache = new Map();

  return function (...args) {
    const key = JSON.stringify(args);

    if (cache.has(key)) {
      console.log(`[memoize] Cache hit for ${key}`);
      return cache.get(key);
    }

    console.log(`[memoize] Computing for ${key}`);
    const result = fn.apply(this, args);

    cache.set(key, result);

    return result;
  };
}
