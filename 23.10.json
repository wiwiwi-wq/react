class ClientRouter {
  constructor(routes) {
    this.routes = routes;
    
    this.handleLinkClick = this.handleLinkClick.bind(this);
    this.handlePopState = this.handlePopState.bind(this);
    
    document.addEventListener('click', this.handleLinkClick);
    window.addEventListener('popstate', this.handlePopState);
    
    this.navigate(window.location.pathname, false);
  }

  handleLinkClick(event) {
    const link = event.target.closest('a');
    
    if (!link || 
        !link.href || 
        link.target === '_blank' || 
        event.ctrlKey || 
        event.metaKey ||
        event.shiftKey ||
        event.altKey) {
      return;
    }

    const url = new URL(link.href);
    
    if (url.origin !== window.location.origin) {
      return;
    }

    event.preventDefault();
    this.navigate(url.pathname, true);
  }

  handlePopState(event) {
    this.navigate(window.location.pathname, false);
  }

  navigate(path, pushState = true) {
    if (pushState) {
      window.history.pushState({}, '', path);
    }

    const handler = this.routes[path];
    
    if (handler) {
      const htmlContent = handler();
      this.render(htmlContent);
    } else {
      this.render(this.routes['/404'] ? this.routes['/404']() : '<h1>404 Not Found</h1>');
    }
  }

  render(content) {
    const app = document.getElementById('app');
    if (app) {
      app.innerHTML = content;
    }
  }

  destroy() {
    document.removeEventListener('click', this.handleLinkClick);
    window.removeEventListener('popstate', this.handlePopState);
  }
}
 
задание 2

function createVNode(type, props, ...children) {
  const processedChildren = children.reduce((acc, child) => {
    if (child !== null && child !== undefined) {
      acc.push(child);
    }
    return acc;
  }, []);

  const finalChildren = processedChildren.length === 1 
    ? processedChildren[0] 
    : processedChildren;

  return {
    type,
    props: {
      ...props,
      children: finalChildren,
    },
    key: props?.key ?? null,
  };
}

задача 3
function shallowEqual(objA, objB) {
  if (Object.is(objA, objB)) {
    return true;
  }

  if (objA === null || objB === null) {
    return false;
  }

  const isObjectA = typeof objA === 'object' && objA !== null && !Array.isArray(objA);
  const isObjectB = typeof objB === 'object' && objB !== null && !Array.isArray(objB);

  if (!isObjectA || !isObjectB) {
    return false;
  }

  const keysA = Object.keys(objA);
  const keysB = Object.keys(objB);

  if (keysA.length !== keysB.length) {
    return false;
  }

  for (let i = 0; i < keysA.length; i++) {
    const key = keysA[i];
    
    if (!Object.prototype.hasOwnProperty.call(objB, key)) {
      return false;
    }

    if (!Object.is(objA[key], objB[key])) {
      return false;
    }
  }

  return true;
}

задача 4

function Parent() {
  let count = 0;
  const listeners = [];

  function subscribe(callback) {
    listeners.push(callback);
    return () => {
      const index = listeners.indexOf(callback);
      if (index > -1) listeners.splice(index, 1);
    };
  }

  function notify() {
    listeners.forEach(callback => callback(count));
  }

  return {
    getCount() {
      return count;
    },
    increment() {
      count++;
      notify();
    },
    subscribe,
  };
}

function Child(state) {
  const { count, onIncrement } = state;

  return {
    render: () => `
      <div class="child">
        <p>Count: ${count}</p>
        <button onclick="onIncrement()">Increment</button>
      </div>
    `,
  };
}

задача 5

function renderToHTML(vNode) {
  if (vNode === null || vNode === undefined) {
    return '';
  }

  if (typeof vNode !== 'object') {
    return String(vNode);
  }

  if (Array.isArray(vNode)) {
    return vNode.map(renderToHTML).join('');
  }

  if (!vNode.type) {
    return String(vNode.props?.children ?? '');
  }

  const { type, props } = vNode;
  const { children, className, style, ...attributes } = props;

  let attrsString = '';

  if (className !== undefined) {
    attrsString += ` class="${className}"`;
  }

  if (style !== undefined) {
    if (typeof style === 'object') {
      const styleString = Object.entries(style)
        .map(([key, value]) => {
          const cssKey = key.replace(/([A-Z])/g, '-$1').toLowerCase();
          return `${cssKey}: ${value}`;
        })
        .join('; ');
      attrsString += ` style="${styleString}"`;
    } else if (typeof style === 'string') {
      attrsString += ` style="${style}"`;
    }
  }

  Object.entries(attributes).forEach(([key, value]) => {
    if (value !== undefined && value !== null && key !== 'key') {
      if (value === true) {
        attrsString += ` ${key}`;
      } else if (value === false) {
        // Не добавляем false атрибуты
      } else {
        const escapedValue = String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
        attrsString += ` ${key}="${escapedValue}"`;
      }
    }
  });

  const selfClosingTags = ['area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link', 'meta', 'param', 'source', 'track', 'wbr'];

  if (selfClosingTags.includes(type)) {
    return `<${type}${attrsString}>`;
  }

  const childrenHTML = children !== undefined
    ? renderToHTML(children)
    : '';

  return `<${type}${attrsString}>${childrenHTML}</${type}>`;
}

задача 6
const fs = require('fs');
const path = require('path');

function validateDependencies(filePath = './package.json') {
  try {
    const absolutePath = path.resolve(filePath);
    const content = fs.readFileSync(absolutePath, 'utf-8');
    const packageJson = JSON.parse(content);

    const dependencies = packageJson.dependencies || {};
    const devDependencies = packageJson.devDependencies || {};

    const allDependencies = { ...dependencies, ...devDependencies };

    if (Object.keys(allDependencies).length === 0) {
      console.log('No dependencies found.');
      return [];
    }

    const problematicPackages = [];

    for (const [packageName, version] of Object.entries(allDependencies)) {
      if (typeof version !== 'string') continue;
      if (version.startsWith('file:') || version.startsWith('npm:') || version.startsWith('git:')) {
        continue;
      }

      if (version.startsWith('^') || version.startsWith('~')) {
        problematicPackages.push({
          package: packageName,
          version: version,
          message: `Range operator found: ${version}`,
        });
      }
    }

    if (problematicPackages.length > 0) {
      console.log('⚠️  Packages with loose version ranges:');
      console.log('─'.repeat(50));
      problematicPackages.forEach(({ package: pkg, version }) => {
        console.log(`  ${pkg.padEnd(40)} ${version}`);
      });
      console.log('─'.repeat(50));
      console.log(`Total: ${problematicPackages.length} package(s) with non-locked versions`);
    } else {
      console.log('✅ All dependencies have pinned versions (no ^ or ~ prefixes)');
    }

    return problematicPackages;
  } catch (error) {
    if (error.code === 'ENOENT') {
      console.error(`Error: package.json not found at ${filePath}`);
    } else if (error instanceof SyntaxError) {
      console.error(`Error: Invalid JSON in package.json - ${error.message}`);
    } else {
      console.error(`Error: ${error.message}`);
    }
    return [];
  }
}

if (require.main === module) {
  validateDependencies();
}

module.exports = { validateDependencies };

задача 7

function checkEnvironment() {
  const currentVersion = process.version;
  const majorVersion = parseInt(currentVersion.slice(1).split('.')[0], 10);

  const MIN_MAJOR_VERSION = 18;

  console.log(`🔍 Node.js version check:`);
  console.log(`   Current version: ${currentVersion}`);
  console.log(`   Required minimum: ${MIN_MAJOR_VERSION}.0.0`);

  if (majorVersion < MIN_MAJOR_VERSION) {
    console.error(`❌ Error: Node.js ${currentVersion} is too old.`);
    console.error(`   Please upgrade to Node.js ${MIN_MAJOR_VERSION} or higher.`);
    console.error(`   Visit: https://nodejs.org/`);

    process.exit(1);
  }

  console.log(`✅ Node.js version is compatible.`);
  console.log(`   Build can proceed.`);
}

checkEnvironment();

